#!/usr/bin/env bash
#
# pre-commit hook for campus-hangouts.
#
# Enable once per repo with:
#   git config core.hooksPath .githooks
#
# Skip it for a specific commit with:
#   SKIP_HOOKS=1 git commit ...

# Allow skipping the whole hook.
if [[ "${SKIP_HOOKS:-0}" == "1" ]]; then
  exit 0
fi

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! cargo fmt --all -- --check; then
  echo "pre-commit: run 'cargo fmt --all'" >&2
  exit 1
fi

if ! cargo clippy --workspace --all-targets --quiet -- -D warnings; then
  echo "pre-commit: clippy failed" >&2
  exit 1
fi
